{
  "name": "seneflix",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "vitest --watch",
    "coverage": "vitest --coverage",
    "test": "vitest",
    "analyze-bundle": "ng build --configuration=analyze-bundle && source-map-explorer dist/**/*.js --no-border-checks",
    "stats": "webpack-bundle-analyzer dist/seneflix/stats.json",
    "preinstall": "npx only-allow pnpm",
    "cleandep": "pnpm clean"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@angular/youtube-player": "^21.2.7",
    "@primeng/themes": "20.5.0-lts",
    "@tailwindcss/postcss": "^4.2.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.2",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.10",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.9",
    "@angular/platform-browser-dynamic": "^21.2.9",
    "@tailwindcss/vite": "^4.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.2.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4",
    "webpack-cli": "^6.0.1"
  }
}
