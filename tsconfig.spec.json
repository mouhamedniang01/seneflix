// tsconfig.spec.json — remplace complètement le fichier
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"],
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/test-setup.ts",
    "src/test-providers.ts"
  ]
}